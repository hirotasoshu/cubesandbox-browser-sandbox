#!/usr/bin/env bash
set -euo pipefail

port="${PLAYWRIGHT_MCP_PORT:-8931}"

for _ in $(seq 1 60); do
    if node -e \
        "fetch('http://127.0.0.1:${port}/mcp').then(() => process.exit(0), () => process.exit(1))"; then
        break
    fi
    if ! pgrep -u user -f '/opt/playwright-mcp/node_modules/.bin/playwright-mcp' >/dev/null; then
        printf 'Playwright MCP is not running as user\n' >&2
        exit 1
    fi
    sleep 0.25
done

pgrep -u user -f '/opt/playwright-mcp/node_modules/.bin/playwright-mcp' >/dev/null
node /usr/local/libexec/browser-sandbox/mcp-http-smoke.mjs \
    "http://localhost:${port}/mcp"
