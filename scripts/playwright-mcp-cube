#!/usr/bin/env bash
set -euo pipefail

for argument in "$@"; do
    case "${argument}" in
        --cdp-endpoint|--cdp-endpoint=*) exec playwright-mcp "$@" ;;
    esac
done

endpoint="${PLAYWRIGHT_MCP_CDP_ENDPOINT:-http://127.0.0.1:${CDP_PORT:-9222}}"
exec playwright-mcp --cdp-endpoint "${endpoint}" "$@"
